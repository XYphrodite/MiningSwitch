<Window x:Class="MiningSwitch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mining Switch" Icon="pack://application:,,,/Assets/MiningSwitch.ico"
        Width="960" Height="796" MinWidth="880" MinHeight="676"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#10141D" Foreground="#F1F5FA"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        StateChanged="OnWindowStateChanged"
        FontFamily="Segoe UI" FontSize="14">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8D0DA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3340" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4554" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A12616" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterFrame" BorderBrush="#1C232C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#10141A" BorderBrush="#1C232C" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                        <Image Width="16" Height="16" Source="pack://application:,,,/Assets/MiningSwitch.ico" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TopBarTitleLabel" Text="Mining Switch" Margin="8,0,0,0" FontSize="12" Foreground="#C8D0DA" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Свернуть">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None" Data="M 1,5 H 9"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Развернуть">
                            <Grid Width="10" Height="10">
                                <Path x:Name="MaximizeGlyph"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" Stretch="None" Data="M 1,1 H 9 V 9 H 1 Z"/>
                                <Path x:Name="RestoreGlyph" Visibility="Collapsed"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" Stretch="None" Data="M 3,1 H 9 V 7 M 1,3 H 7 V 9 H 1 Z"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="Свернуть в трей">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None" Data="M 1,1 L 9,9 M 9,1 L 1,9"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ContentRoot" Grid.Row="1" Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MINING SWITCH" Foreground="#61E8BA" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="VersionLabel" Foreground="#929FB4" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Твой ПК. Всё под контролем." FontSize="27" FontWeight="SemiBold" Margin="0,7,0,4"/>
                <TextBlock x:Name="ComputerLabel" Foreground="#929FB4" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="UpdateButton" Content="Проверить обновления" Style="{StaticResource SmallButton}" Margin="0" FontSize="12" Click="OnUpdateClick"/>
                <TextBlock x:Name="UpdateStatusLabel" Foreground="#929FB4" FontSize="11" HorizontalAlignment="Right" Margin="0,5,2,0"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,16">
            <Border Background="#1B2331" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ПРОЦЕССОР" FontSize="10" Foreground="#929FB4"/>
                    <TextBlock x:Name="CpuLabel" Text="—" FontSize="19" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1B2331" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" FontSize="10" Foreground="#929FB4"/>
                    <TextBlock x:Name="RamLabel" Text="—" FontSize="19" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1B2331" CornerRadius="12" Padding="14">
                <StackPanel>
                    <TextBlock Text="СВОБОДНО НА ДИСКАХ" FontSize="10" Foreground="#929FB4"/>
                    <TextBlock x:Name="DiskLabel" Text="—" FontSize="16" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,18,0">
                <Border Background="#1B2331" CornerRadius="16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="XMRig · процессор" Foreground="#929FB4" FontSize="12"/>
                        <TextBlock x:Name="StatusLabel" Text="Подключение…" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HashrateLabel" Text="—" FontSize="24"/>
                            <TextBlock Text=" H/s" Foreground="#929FB4" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="#1B2331" CornerRadius="16" Padding="18" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="GpuTitleLabel" Text="GPU · видеокарта" Foreground="#929FB4" FontSize="12"/>
                        <TextBlock x:Name="GpuStatusLabel" Text="Проверяем GPU…" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,6"/>
                        <TextBlock x:Name="GpuRateLabel" Text="—" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Button x:Name="PowerButton" Background="#61E8BA" Foreground="#10251E" IsEnabled="False" Height="136" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PowerLabel" Text="Проверяем майнеры" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Background="#1B2331" CornerRadius="16" Padding="22" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="ТВОЙ ПК · CPU + GPU · ОЦЕНКА" Foreground="#61E8BA" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Прогноз ₽/сутки · по средней скорости пула" Foreground="#A7B4C8" Margin="0,18,0,2" FontSize="12"/>
                    <TextBlock x:Name="IncomeDayLabel" Text="— ₽" FontSize="42" FontWeight="SemiBold"/>
                    <TextBlock x:Name="IncomeDetailLabel" Text="Загружаем статистику воркера…" Foreground="#A7B4C8" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,18"/>

                    <Border Background="#293449" Height="1" Margin="0,0,0,14"/>

                    <TextBlock Text="ВСЕ КОМПЬЮТЕРЫ · CPU + GPU" Foreground="#61E8BA" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FleetIncomeLabel" Text="— ₽" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,4"/>
                    <TextBlock x:Name="FleetDetailsLabel" Text="Оценка за сутки по всем воркерам кошелька." Foreground="#A7B4C8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Button x:Name="RefreshIncomeButton" Content="Обновить доход" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Click="OnRefreshIncome"/>
                    <TextBlock x:Name="IncomeNoteLabel" Foreground="#929FB4" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock Text="Это оценка, а не начисления: PPLNS, удача пула и электричество не учитываются." Foreground="#929FB4" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="NoteLabel" Grid.Row="3" Text="Крестик сворачивает окно к часам. Ручное выключение сохраняется после перезагрузки." Foreground="#929FB4" TextWrapping="Wrap" Margin="2,15,2,0" FontSize="12" MinHeight="30"/>
            </Grid>
        </Grid>
    </Border>
</Window>
